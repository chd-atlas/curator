# curator-llama: the curator image plus llama.cpp, for a llama-server inside one pipeline task
# (serve-and-ask.sh). Built as the 2026-11-26 CPU benchmark's build job built it: pinned tag,
# runtime CPU detection (one binary picks the best CPU backend on whatever node runs it).
#
#   docker build -f Dockerfile.llama --build-arg CURATOR_IMAGE=<curator image, by digest> -t curator-llama .

ARG CURATOR_IMAGE=curator

FROM ${CURATOR_IMAGE} AS build

ARG LLAMA_TAG=b12246
ARG LLAMA_COMMIT=78ffbaa18533c2ed51eab2ef5ae0702330efc3e9

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# A shallow clone resolves the server's embedded web-UI version to "b1" and fetches the wrong
# assets, so the version is pinned with HF_UI_VERSION (as llama-build.sbatch does). The tag is checked
# against the commit it was measured at; a moved tag fails the build.
ENV HF_UI_VERSION=${LLAMA_TAG}
RUN git clone --depth 1 --branch "${LLAMA_TAG}" https://github.com/ggml-org/llama.cpp /opt/llama-cpp \
    && test "$(git -C /opt/llama-cpp rev-parse HEAD)" = "${LLAMA_COMMIT}"
WORKDIR /opt/llama-cpp
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
      -DGGML_NATIVE=OFF -DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON -DBUILD_SHARED_LIBS=ON \
      -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF \
    && cmake --build build -j "$(nproc)" --target llama-server

FROM ${CURATOR_IMAGE}

# Runtime libraries of the compiler's runtime that llama-server links against.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# The binaries stay at the path they were built at: the build tree's library search path and the
# CPU backend modules (loaded from the executable's directory) are both relative to it.
COPY --from=build /opt/llama-cpp/build/bin /opt/llama-cpp/build/bin
ENV PATH=/opt/llama-cpp/build/bin:$PATH \
    LD_LIBRARY_PATH=/opt/llama-cpp/build/bin
